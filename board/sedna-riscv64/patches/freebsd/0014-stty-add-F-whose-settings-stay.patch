 				err(1, "%s", optarg);
@@ -137,16 +143,39 @@ args:	argc -= optind;
 
 	if (i.set && tcsetattr(i.fd, 0, &i.t) < 0)
 		err(1, "tcsetattr");
+	if (i.set && initstate)
