diff --git a/bin/stty/stty.c b/bin/stty/stty.c
index 38834aaccea0..5e2bd06fb0a9 100644
--- a/bin/stty/stty.c
+++ b/bin/stty/stty.c
@@ -41,6 +41,8 @@
