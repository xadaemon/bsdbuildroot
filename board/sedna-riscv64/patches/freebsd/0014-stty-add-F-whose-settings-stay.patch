+/*
+ * -F: the settings also become the terminal's initial state (its .init
+ * device, see tty(4)), which every first open starts with, so that they
+ * stay until changed, as with Linux's stty -F.
+ */
+static void
+setinit(const char *file, struct termios *t)
+{
+	char path[PATH_MAX], init[PATH_MAX + sizeof(".init")];
+	int fd;
+
+	if (realpath(file, path) == NULL)
+		err(1, "%s", file);
+	(void)snprintf(init, sizeof(init), "%s.init", path);
+	if ((fd = open(init, O_RDONLY | O_NONBLOCK)) < 0)
+		return;		/* No initial state to set. */
+	if (tcsetattr(fd, 0, t) < 0)
+		err(1, "%s", init);
+	(void)close(fd);
+}
+
 void
 usage(void)
 {
 
 	(void)fprintf(stderr,
-	    "usage: stty [-a | -e | -g] [-f file] [arguments]\n");
+	    "usage: stty [-a | -e | -g] [-f | -F file] [arguments]\n");
 	exit (1);
 }
