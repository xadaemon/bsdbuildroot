+/*
+ * The parts of luaposix's posix.dirent, posix.errno, posix.fcntl, posix.poll,
+ * posix.signal, posix.sys.socket, posix.sys.stat and posix.time that
+ * OpenComputers II's Lua libraries use, with luaposix's calling conventions:
+ * failures return nil, a message and the errno value.
+ */
+
+static int
+push_error(lua_State *L, int error)
+{
+	lua_pushnil(L);
+	lua_pushstring(L, strerror(error));
+	lua_pushinteger(L, error);
+	return (3);
+}
+
+static int
+push_result(lua_State *L, int ret)
+{
+	if (ret == -1)
+		return (push_error(L, errno));
+	lua_pushinteger(L, ret);
+	return (1);
+}
+
+/* posix.dirent */
+
+static int
+lua_dir(lua_State *L)
+{
+	const char *path;
+	struct dirent *entry;
+	DIR *dir;
+	int i;
+
+	enforce_max_args(L, 1);
+	path = luaL_optstring(L, 1, ".");
+	dir = opendir(path);
+	if (dir == NULL)
+		return (push_error(L, errno));
+	lua_newtable(L);
+	i = 1;
+	while ((entry = readdir(dir)) != NULL) {
+		lua_pushstring(L, entry->d_name);
+		lua_rawseti(L, -2, i++);
+	}
+	closedir(dir);
+	return (1);
+}
+
+static int
+lua_files_next(lua_State *L)
+{
+	DIR **dir = luaL_checkudata(L, 1, "posix.dirent.files");
+	struct dirent *entry;
+
+	if (*dir == NULL)
+		return (0);
+	entry = readdir(*dir);
+	if (entry == NULL) {
+		closedir(*dir);
+		*dir = NULL;
+		return (0);
+	}
+	lua_pushstring(L, entry->d_name);
+	return (1);
+}
+
+static int
+lua_files_gc(lua_State *L)
+{
+	DIR **dir = luaL_checkudata(L, 1, "posix.dirent.files");
+
+	if (*dir != NULL) {
+		closedir(*dir);
+		*dir = NULL;
+	}
+	return (0);
+}
+
+static int
+lua_files(lua_State *L)
+{
+	const char *path;
+	DIR **dir;
+
+	enforce_max_args(L, 1);
+	path = luaL_optstring(L, 1, ".");
+	lua_pushcfunction(L, lua_files_next);
+	dir = lua_newuserdatauv(L, sizeof(*dir), 0);
+	*dir = NULL;
+	if (luaL_newmetatable(L, "posix.dirent.files")) {
+		lua_pushcfunction(L, lua_files_gc);
+		lua_setfield(L, -2, "__gc");
+		lua_pushcfunction(L, lua_files_gc);
+		lua_setfield(L, -2, "__close");
+	}
+	lua_setmetatable(L, -2);
+	*dir = opendir(path);
+	if (*dir == NULL)
+		return (luaL_error(L, "%s: %s", path, strerror(errno)));
+	return (2);
+}
+
+/* posix.errno */
+
+static int
+lua_errno(lua_State *L)
+{
+	int error;
+
+	enforce_max_args(L, 1);
+	error = (int)luaL_optinteger(L, 1, errno);
+	lua_pushstring(L, strerror(error));
+	lua_pushinteger(L, error);
+	return (2);
+}
+
+/* posix.fcntl */
+
+static int
+lua_open(lua_State *L)
+{
+	const char *path;
+	int flags;
+	mode_t mode;
+
+	enforce_max_args(L, 3);
+	path = luaL_checkstring(L, 1);
+	flags = (int)luaL_checkinteger(L, 2);
+	mode = (mode_t)luaL_optinteger(L, 3, 0777);
+	return (push_result(L, open(path, flags, mode)));
+}
+
+static int
+lua_fcntl(lua_State *L)
+{
+	int cmd, fd;
+
+	enforce_max_args(L, 3);
+	fd = (int)luaL_checkinteger(L, 1);
+	cmd = (int)luaL_checkinteger(L, 2);
+	switch (cmd) {
+	case F_GETFD:
+	case F_SETFD:
+	case F_GETFL:
+	case F_SETFL:
+	case F_DUPFD:
+	case F_DUPFD_CLOEXEC:
+	case F_GETOWN:
+	case F_SETOWN:
+		return (push_result(L,
+		    fcntl(fd, cmd, (int)luaL_optinteger(L, 3, 0))));
+	default:
+		return (push_error(L, EINVAL));
+	}
+}
+
+/* posix.poll */
+
+static const struct {
+	const char	*name;
+	short		 bit;
+} poll_events[] = {
+	{ "IN",		POLLIN },
+	{ "PRI",	POLLPRI },
+	{ "OUT",	POLLOUT },
+	{ "RDNORM",	POLLRDNORM },
+	{ "RDBAND",	POLLRDBAND },
+	{ "WRNORM",	POLLWRNORM },
+	{ "WRBAND",	POLLWRBAND },
+	{ "ERR",	POLLERR },
+	{ "HUP",	POLLHUP },
+	{ "NVAL",	POLLNVAL },
+};
+
+static short
+poll_events_from_table(lua_State *L, int index)
+{
+	short events = 0;
+	size_t i;
+
+	if (!lua_istable(L, index))
+		return (0);
+	for (i = 0; i < nitems(poll_events); i++) {
+		lua_getfield(L, index, poll_events[i].name);
+		if (lua_toboolean(L, -1))
+			events |= poll_events[i].bit;
+		lua_pop(L, 1);
+	}
+	return (events);
+}
+
+static void
+poll_events_to_table(lua_State *L, short events)
+{
+	size_t i;
+
+	lua_createtable(L, 0, nitems(poll_events));
+	for (i = 0; i < nitems(poll_events); i++) {
+		lua_pushboolean(L, (events & poll_events[i].bit) != 0);
+		lua_setfield(L, -2, poll_events[i].name);
+	}
+}
+
+/* poll({[fd] = {events = {IN = true, ...}}, ...}, timeout): sets revents. */
+static int
+lua_poll(lua_State *L)
+{
+	struct pollfd *fds;
+	nfds_t i, n;
+	int error, ret, timeout;
+
+	enforce_max_args(L, 2);
+	luaL_checktype(L, 1, LUA_TTABLE);
+	timeout = (int)luaL_optinteger(L, 2, -1);
+
+	n = 0;
+	lua_pushnil(L);
+	while (lua_next(L, 1) != 0) {
+		luaL_argcheck(L, lua_isinteger(L, -2), 1,
+		    "descriptors must be integers");
+		n++;
+		lua_pop(L, 1);
+	}
+
+	fds = lua_newuserdatauv(L, (n > 0 ? n : 1) * sizeof(*fds), 0);
+	i = 0;
+	lua_pushnil(L);
+	while (lua_next(L, 1) != 0) {
+		fds[i].fd = (int)lua_tointeger(L, -2);
+		lua_getfield(L, -1, "events");
+		fds[i].events = poll_events_from_table(L, lua_gettop(L));
+		fds[i].revents = 0;
+		lua_pop(L, 2);
+		i++;
+	}
+
+	ret = poll(fds, n, timeout);
+	if (ret == -1) {
+		error = errno;
+		return (push_error(L, error));
+	}
+
+	for (i = 0; i < n; i++) {
+		lua_rawgeti(L, 1, fds[i].fd);
+		if (lua_istable(L, -1)) {
+			poll_events_to_table(L, fds[i].revents);
+			lua_setfield(L, -2, "revents");
+		}
+		lua_pop(L, 1);
+	}
+	lua_pushinteger(L, ret);
+	return (1);
+}
+
+/* rpoll(fd, timeout): whether fd is readable. */
+static int
+lua_rpoll(lua_State *L)
+{
+	struct pollfd pfd;
+
+	enforce_max_args(L, 2);
+	pfd.fd = (int)luaL_checkinteger(L, 1);
+	pfd.events = POLLIN;
+	pfd.revents = 0;
+	return (push_result(L, poll(&pfd, 1, (int)luaL_checkinteger(L, 2))));
+}
+
+/* posix.signal */
+
+#define	LUA_SIGNAL_HANDLERS	"posix.signal.handlers"
+
+static lua_State *signal_state;
+static volatile sig_atomic_t signal_pending[NSIG];
+static volatile sig_atomic_t signal_any;
+static lua_Hook signal_saved_hook;
+static int signal_saved_mask, signal_saved_count;
+
+static void
+signal_hook(lua_State *L, lua_Debug *ar)
+{
+	int sig;
+
+	(void)ar;
+	lua_sethook(L, signal_saved_hook, signal_saved_mask,
+	    signal_saved_count);
+	while (signal_any) {
+		signal_any = 0;
+		for (sig = 1; sig < NSIG; sig++) {
+			if (!signal_pending[sig])
+				continue;
+			signal_pending[sig] = 0;
+			lua_getfield(L, LUA_REGISTRYINDEX,
+			    LUA_SIGNAL_HANDLERS);
+			lua_rawgeti(L, -1, sig);
+			lua_remove(L, -2);
+			if (lua_isfunction(L, -1)) {
+				lua_pushinteger(L, sig);
+				lua_call(L, 1, 0);
+			} else {
+				lua_pop(L, 1);
+			}
+		}
+	}
+}
+
+/* Runs the Lua handler at the next safe point, through a hook. */
+static void
+signal_catch(int sig)
+{
+	lua_State *L = signal_state;
+
+	signal_pending[sig] = 1;
+	if (signal_any || L == NULL) {
+		signal_any = 1;
+		return;
+	}
+	signal_any = 1;
+	signal_saved_hook = lua_gethook(L);
+	signal_saved_mask = lua_gethookmask(L);
+	signal_saved_count = lua_gethookcount(L);
+	lua_sethook(L, signal_hook,
+	    LUA_MASKCALL | LUA_MASKRET | LUA_MASKCOUNT, 1);
+}
+
+static void
+push_signal_handler(lua_State *L, int sig, void (*handler)(int))
+{
+	if (handler != signal_catch) {
+		lua_pushlightuserdata(L, (void *)handler);
+		return;
+	}
+	lua_getfield(L, LUA_REGISTRYINDEX, LUA_SIGNAL_HANDLERS);
+	lua_rawgeti(L, -1, sig);
+	lua_remove(L, -2);
+}
+
+/* signal(sig[, handler[, flags]]): handler is SIG_DFL, SIG_IGN or a
+ * function; returns the previous one. */
+static int
+lua_signal(lua_State *L)
+{
+	struct sigaction sa, old;
+	int sig;
+
+	enforce_max_args(L, 3);
+	sig = (int)luaL_checkinteger(L, 1);
+	luaL_argcheck(L, sig > 0 && sig < NSIG, 1, "invalid signal");
+
+	memset(&sa, 0, sizeof(sa));
+	sigfillset(&sa.sa_mask);
+	sa.sa_flags = (int)luaL_optinteger(L, 3, 0);
+	if (lua_isnoneornil(L, 2)) {
+		sa.sa_handler = SIG_DFL;
+	} else if (lua_islightuserdata(L, 2)) {
+		sa.sa_handler = (void (*)(int))lua_touserdata(L, 2);
+		luaL_argcheck(L, sa.sa_handler == SIG_DFL ||
+		    sa.sa_handler == SIG_IGN, 2, "SIG_DFL or SIG_IGN expected");
+	} else {
+		luaL_checktype(L, 2, LUA_TFUNCTION);
+		sa.sa_handler = signal_catch;
+	}
+
+	if (sigaction(sig, NULL, &old) == -1)
+		return (push_error(L, errno));
+	push_signal_handler(L, sig, old.sa_handler);
+
+	if (sa.sa_handler == signal_catch) {
+		lua_getfield(L, LUA_REGISTRYINDEX, LUA_SIGNAL_HANDLERS);
+		lua_pushvalue(L, 2);
+		lua_rawseti(L, -2, sig);
+		lua_pop(L, 1);
+		/* Hooks are per thread: run handlers in the main one. */
+		lua_rawgeti(L, LUA_REGISTRYINDEX, LUA_RIDX_MAINTHREAD);
+		signal_state = lua_tothread(L, -1);
+		lua_pop(L, 1);
+	}
+	if (sigaction(sig, &sa, NULL) == -1)
+		return (push_error(L, errno));
+	return (1);
+}
+
+static int
+lua_kill(lua_State *L)
+{
+	enforce_max_args(L, 2);
+	return (push_result(L, kill((pid_t)luaL_checkinteger(L, 1),
+	    (int)luaL_optinteger(L, 2, SIGTERM))));
+}
+
+static int
+lua_raise(lua_State *L)
+{
+	enforce_max_args(L, 1);
+	return (push_result(L, raise((int)luaL_checkinteger(L, 1))));
+}
+
+/* posix.sys.socket, AF_UNIX addresses only. */
+
+static int
+socket_address(lua_State *L, int index, struct sockaddr_un *sun)
+{
+	const char *path;
+	size_t len;
+	int family;
+
+	luaL_checktype(L, index, LUA_TTABLE);
+	lua_getfield(L, index, "family");
+	family = (int)luaL_checkinteger(L, -1);
+	lua_pop(L, 1);
+	if (family != AF_UNIX)
+		return (EAFNOSUPPORT);
+	lua_getfield(L, index, "path");
+	path = luaL_checklstring(L, -1, &len);
+	if (len >= sizeof(sun->sun_path)) {
+		lua_pop(L, 1);
+		return (ENAMETOOLONG);
+	}
+	memset(sun, 0, sizeof(*sun));
+	sun->sun_len = sizeof(*sun);
+	sun->sun_family = AF_UNIX;
+	memcpy(sun->sun_path, path, len);
+	lua_pop(L, 1);
+	return (0);
+}
+
+static void
+push_socket_address(lua_State *L, const struct sockaddr_storage *ss)
+{
+	const struct sockaddr_un *sun = (const struct sockaddr_un *)ss;
+
+	lua_newtable(L);
+	lua_pushinteger(L, ss->ss_family);
+	lua_setfield(L, -2, "family");
+	if (ss->ss_family == AF_UNIX) {
+		lua_pushstring(L, sun->sun_path);
+		lua_setfield(L, -2, "path");
+	}
+}
+
+static int
+lua_socket(lua_State *L)
+{
+	enforce_max_args(L, 3);
+	return (push_result(L, socket((int)luaL_checkinteger(L, 1),
+	    (int)luaL_checkinteger(L, 2), (int)luaL_optinteger(L, 3, 0))));
+}
+
+static int
+lua_bind(lua_State *L)
+{
+	struct sockaddr_un sun;
+	int error;
+
+	enforce_max_args(L, 2);
+	error = socket_address(L, 2, &sun);
+	if (error != 0)
+		return (push_error(L, error));
+	return (push_result(L, bind((int)luaL_checkinteger(L, 1),
+	    (struct sockaddr *)&sun, sizeof(sun))));
+}
+
+static int
+lua_connect(lua_State *L)
+{
+	struct sockaddr_un sun;
+	int error;
+
+	enforce_max_args(L, 2);
+	error = socket_address(L, 2, &sun);
+	if (error != 0)
+		return (push_error(L, error));
+	return (push_result(L, connect((int)luaL_checkinteger(L, 1),
+	    (struct sockaddr *)&sun, sizeof(sun))));
+}
+
+static int
+lua_listen(lua_State *L)
+{
+	enforce_max_args(L, 2);
+	return (push_result(L, listen((int)luaL_checkinteger(L, 1),
+	    (int)luaL_optinteger(L, 2, SOMAXCONN))));
+}
+
+static int
+lua_accept(lua_State *L)
+{
+	struct sockaddr_storage ss;
+	socklen_t len;
+	int fd;
+
+	enforce_max_args(L, 1);
+	len = sizeof(ss);
+	memset(&ss, 0, sizeof(ss));
+	fd = accept((int)luaL_checkinteger(L, 1), (struct sockaddr *)&ss,
+	    &len);
+	if (fd == -1)
+		return (push_error(L, errno));
+	lua_pushinteger(L, fd);
+	push_socket_address(L, &ss);
+	return (2);
+}
+
+static int
+lua_shutdown(lua_State *L)
+{
+	enforce_max_args(L, 2);
+	return (push_result(L, shutdown((int)luaL_checkinteger(L, 1),
+	    (int)luaL_checkinteger(L, 2))));
+}
+
+/* getsockopt(fd, level, name): integer options only. */
+static int
+lua_getsockopt(lua_State *L)
+{
+	socklen_t len;
+	int fd, level, name, value;
+
+	enforce_max_args(L, 3);
+	fd = (int)luaL_checkinteger(L, 1);
+	level = (int)luaL_checkinteger(L, 2);
+	name = (int)luaL_checkinteger(L, 3);
+	if (level != SOL_SOCKET)
+		return (push_error(L, ENOPROTOOPT));
+	switch (name) {
+	case SO_ERROR:
+	case SO_TYPE:
+	case SO_REUSEADDR:
+	case SO_KEEPALIVE:
+	case SO_SNDBUF:
+	case SO_RCVBUF:
+		break;
+	default:
+		return (push_error(L, ENOPROTOOPT));
+	}
+	len = sizeof(value);
+	if (getsockopt(fd, level, name, &value, &len) == -1)
+		return (push_error(L, errno));
+	lua_pushinteger(L, value);
+	return (1);
+}
+
+static int
+lua_recv(lua_State *L)
+{
+	luaL_Buffer b;
+	ssize_t ret;
+	size_t sz;
+	char *buf;
+	int fd;
+
+	enforce_max_args(L, 2);
+	fd = (int)luaL_checkinteger(L, 1);
+	sz = (size_t)luaL_checkinteger(L, 2);
+	buf = luaL_buffinitsize(L, &b, sz);
+	ret = recv(fd, buf, sz, 0);
+	if (ret == -1)
+		return (push_error(L, errno));
+	luaL_pushresultsize(&b, ret);
+	return (1);
+}
+
+static int
+lua_send(lua_State *L)
+{
+	const char *buf;
+	ssize_t ret;
+	size_t sz;
+
+	enforce_max_args(L, 2);
+	buf = luaL_checklstring(L, 2, &sz);
+	ret = send((int)luaL_checkinteger(L, 1), buf, sz, 0);
+	if (ret == -1)
+		return (push_error(L, errno));
+	lua_pushinteger(L, ret);
+	return (1);
+}
+
+/* posix.sys.stat */
+
+static void
+push_stat(lua_State *L, const struct stat *sb)
+{
+	lua_newtable(L);
+#define	setst(f) do {				\
+	lua_pushinteger(L, (lua_Integer)sb->f);	\
+	lua_setfield(L, -2, #f);		\
+} while (0)
+	setst(st_dev);
+	setst(st_ino);
+	setst(st_mode);
+	setst(st_nlink);
+	setst(st_uid);
+	setst(st_gid);
+	setst(st_rdev);
+	setst(st_size);
+	setst(st_blksize);
+	setst(st_blocks);
+	setst(st_atime);
+	setst(st_mtime);
+	setst(st_ctime);
+#undef setst
+}
+
+static int
+lua_stat(lua_State *L)
+{
+	struct stat sb;
+
+	enforce_max_args(L, 1);
+	if (stat(luaL_checkstring(L, 1), &sb) == -1)
+		return (push_error(L, errno));
+	push_stat(L, &sb);
+	return (1);
+}
+
+static int
+lua_lstat(lua_State *L)
+{
+	struct stat sb;
+
+	enforce_max_args(L, 1);
+	if (lstat(luaL_checkstring(L, 1), &sb) == -1)
+		return (push_error(L, errno));
+	push_stat(L, &sb);
+	return (1);
+}
+
+static int
+lua_mkdir(lua_State *L)
+{
+	enforce_max_args(L, 2);
+	return (push_result(L, mkdir(luaL_checkstring(L, 1),
+	    (mode_t)luaL_optinteger(L, 2, 0777))));
+}
+
+#define	S_ISFUNC(f)						\
+static int							\
+lua_##f(lua_State *L)						\
+{								\
+	enforce_max_args(L, 1);					\
+	lua_pushinteger(L, f((mode_t)luaL_checkinteger(L, 1)));	\
+	return (1);						\
+}
+S_ISFUNC(S_ISBLK)
+S_ISFUNC(S_ISCHR)
+S_ISFUNC(S_ISDIR)
+S_ISFUNC(S_ISFIFO)
+S_ISFUNC(S_ISLNK)
+S_ISFUNC(S_ISREG)
+S_ISFUNC(S_ISSOCK)
+#undef S_ISFUNC
+
+/* posix.time */
