#!/bin/sh
#
# initdisks: sets up the machine's other disks (OC2 hard drives besides the
# one FreeBSD runs from): a UFS file system with a volume label, mounted at
# /mnt/<label>, now and at every boot (/etc/rc.d/S10disks).
#
#   initdisks                     list the disks and what is on them
#   initdisks -a                  initialize every blank disk
#   initdisks [-f] DISK [LABEL]   initialize DISK (vtbd1 or /dev/vtbd1), with
#                                 LABEL (default: disk1, disk2, ...); -f also
#                                 if it is not blank, erasing what is on it
#

PATH=/sbin:/bin:/usr/sbin:/usr/bin

die() {
	echo "initdisks: $*" >&2
	exit 1
}

usage() {
	cat >&2 <<EOF
usage: initdisks                     list the disks
       initdisks -a                  initialize every blank disk
       initdisks [-f] DISK [LABEL]   initialize DISK, -f even if not blank
EOF
	exit 1
}

conftxt() {
	sysctl -n kern.geom.conftxt
}

# The disks, by name: vtbd0, vtbd1, ...
disks() {
	conftxt | awk '$1 == 0 && $2 == "DISK" && $3 ~ /^vtbd/ { print $3 }' |
	    sort -k 1.5n
}

# The disk the root file system is on.
system_disk() {
	root=$(mount -p | awk '$2 == "/" { print $1 }')
	conftxt | awk -v name="${root#/dev/}" \
	    '$1 == 0 { disk = $3 } $3 == name { print disk; exit }'
}

disk_bytes() {
	conftxt | awk -v disk="$1" '$1 == 0 && $3 == disk { print $4 }'
}

# What GEOM found on a disk: partitions and labels, "TYPE NAME" per line.
disk_contents() {
	conftxt | awk -v disk="$1" '
	    $1 == 0 { current = $3; next }
	    current == disk { print $2, $3 }'
}

# The UFS volume label of a disk's file system, if it has one.
disk_label() {
	disk_contents "$1" | awk '$1 == "LABEL" && $2 ~ /^ufs\// {
	    sub(/^ufs\//, "", $2); print $2; exit }'
}

# Blank: nothing but zeros where partition tables and file systems keep
# their metadata (MBR, GPT, BSD label, ext2 and UFS superblocks).
is_blank() {
	[ -z "$(disk_contents "$1")" ] &&
	    [ "$(dd if="/dev/$1" bs=64k count=2 2>/dev/null |
	    tr -d '\000' | wc -c)" -eq 0 ]
}

mount_point() {
	mount -p | awk -v dev="$1" '$1 == dev { print $2; exit }'
}

size() {
	if [ "$1" -ge 1048576 ]; then
		echo "$(($1 / 1048576))M"
	else
		echo "$(($1 / 1024))K"
	fi
}

# disk1, disk2, ...: the first name no disk has, and no disk had on this
# machine (its mount point is left over), so a disk that comes back later
# does not find another one with its name.
next_label() {
	n=1
	while [ -e "/dev/ufs/disk$n" ] || [ -e "/mnt/disk$n" ]; do
		n=$((n + 1))
	done
	echo "disk$n"
}

list() {
	system=$(system_disk)
	for disk in $(disks); do
		printf '%-7s %6s  ' "$disk" "$(size "$(disk_bytes "$disk")")"
		label=$(disk_label "$disk")
		if [ "$disk" = "$system" ]; then
			echo "system disk"
		elif [ -n "$label" ]; then
			at=$(mount_point "/dev/ufs/$label")
			if [ -n "$at" ]; then
				echo "UFS, label $label, mounted at $at"
			else
				echo "UFS, label $label, not mounted"
			fi
		elif is_blank "$disk"; then
			echo "blank: initdisks $disk"
		else
			echo "not blank, no labelled UFS file system:" \
			    "initdisks -f $disk erases it"
		fi
	done
}

init() {
	force=$1 disk=${2#/dev/} label=$3

	disks | grep -qx "$disk" || die "$disk: no such disk (see initdisks)"
	[ "$disk" != "$(system_disk)" ] ||
	    die "$disk is the system disk, FreeBSD runs from it"
	old=$(disk_label "$disk")
	if [ -n "$old" ] && [ -n "$(mount_point "/dev/ufs/$old")" ]; then
		die "$disk is mounted at $(mount_point "/dev/ufs/$old"):" \
		    "umount it first"
	fi
	if [ "$force" = no ] && ! is_blank "$disk"; then
		die "$disk is not blank; initdisks -f $disk erases what is on it"
	fi

	[ -n "$label" ] || label=$(next_label)
	case "$label" in
	''|*[!A-Za-z0-9._-]*)
		die "$label: a label is made of letters, digits, '.', '-', '_'" ;;
	builtin)
		die "builtin: /mnt/builtin is OC2's file system" ;;
	esac
	[ "${#label}" -le 31 ] || die "$label: a label has 31 characters at most"
	[ ! -e "/dev/ufs/$label" ] || die "$label: another disk has that label"

	bytes=$(disk_bytes "$disk")
	echo "Initializing $disk ($(size "$bytes")) as $label, mounted at /mnt/$label"
	# Erase what could make GEOM find partitions or labels on the disk:
	# its first and last 64 KB (partition tables, glabel metadata).
	dd if=/dev/zero of="/dev/$disk" bs=64k count=1 2>/dev/null &&
	    dd if=/dev/zero of="/dev/$disk" bs=512 count=128 \
	    seek=$((bytes / 512 - 128)) 2>/dev/null ||
	    die "$disk is in use"
	# As the root file system: soft updates, small blocks for small files.
	newfs -U -L "$label" -b 8192 -f 1024 -i 16384 -m 5 -o space \
	    "/dev/$disk" >/dev/null || die "newfs failed"
	# GEOM looks at the disk again once newfs closes it.
	i=0
	while [ ! -e "/dev/ufs/$label" ] && [ "$i" -lt 50 ]; do
		sleep 0.1
		i=$((i + 1))
	done
	[ -e "/dev/ufs/$label" ] || die "/dev/ufs/$label did not show up"
	sh /etc/rc.d/S10disks start
}

all=no force=no
while getopts af opt; do
	case "$opt" in
	a) all=yes ;;
	f) force=yes ;;
	*) usage ;;
	esac
done
shift $((OPTIND - 1))

[ "$(id -u)" -eq 0 ] || die "only root can initialize disks"
if [ "$all" = yes ]; then
	[ $# -eq 0 ] && [ "$force" = no ] || usage
	found=no
	system=$(system_disk)
	for disk in $(disks); do
		[ "$disk" != "$system" ] && is_blank "$disk" || continue
		found=yes
		(init no "$disk" "") || exit 1
	done
	[ "$found" = yes ] || echo "No blank disks."
elif [ $# -eq 0 ]; then
	[ "$force" = no ] || usage
	list
else
	[ $# -le 2 ] || usage
	init "$force" "$1" "${2:-}"
fi
