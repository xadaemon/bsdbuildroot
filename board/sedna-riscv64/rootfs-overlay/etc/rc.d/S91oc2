#!/bin/sh
#
# OpenComputers II's high-level API (HLAPI): sets the system up so that OC2's
# own Lua libraries on /mnt/builtin (require("devices"), lsdev.lua, ...) and
# its bus daemon run unchanged, as they do on OC2's Linux image:
#
#  - The HLAPI's virtio console ports (oc2.rpc.0, oc2.blob.0, oc2.event.0)
#    are ttys on FreeBSD (/dev/ttyV0.N, /dev/vtcon/<name>): make them raw,
#    and list them like Linux's /sys/class/virtio-ports, where the libraries
#    look them up.
#  - LUA_PATH includes /mnt/builtin/lib/lua, like OC2's S20export_lua_path.
#  - oc2busd, which shares the ports between programs, runs under daemon(8)
#    (restarted if it stops, output to syslog), like OC2's S25oc2busd.
#    touch /etc/oc2busd.disabled to not start it; programs then open the
#    ports directly, one at a time. While it runs, programs must not open
#    the ports themselves (e.g. with OC2_BUS_SOCKET=none): FreeBSD lets a
#    port be opened twice, where Linux refuses with EBUSY.
#

BUILTIN="/mnt/builtin"
LUA_LIB="$BUILTIN/lib/lua"
DAEMON="$BUILTIN/bin/oc2busd.lua"
PORTS="/sys/class/virtio-ports"
PID_FILE="/run/oc2busd.pid"
PROFILE="/etc/profile.d/lua_path.sh"

lua_path() {
	# The trailing ";;" adds flua's default path.
	echo "$LUA_LIB/?.lua;$LUA_LIB/?/init.lua;;"
}

setup_ports() {
	rm -rf "$PORTS"
	mkdir -p "$PORTS"
	for alias in /dev/vtcon/*; do
		[ -e "$alias" ] || continue
		tty=$(readlink "$alias")
		tty=${tty##*/}
		[ -c "/dev/$tty" ] || continue
		# The .init device holds the settings each open starts with.
		stty -f "/dev/$tty.init" raw -echo -ixon -ixoff
		stty -f "/dev/$tty" raw -echo -ixon -ixoff 2>/dev/null
		mkdir -p "$PORTS/$tty"
		echo "${alias##*/}" > "$PORTS/$tty/name"
	done
}

start() {
	printf 'Setting up the OC2 high-level API: '
	setup_ports
	if [ ! -d "$LUA_LIB" ]; then
		printf 'no %s, skipped\n' "$LUA_LIB"
		return 0
	fi
	{
		printf '# Generated by %s on every boot.\n' "$0"
		printf 'export LUA_PATH="%s"\n' "$(lua_path)"
	} > "$PROFILE"

	if [ -e /etc/oc2busd.disabled ]; then
		printf 'OK, oc2busd disabled\n'
	elif [ ! -f "$DAEMON" ] || [ ! -e /dev/vtcon/oc2.rpc.0 ]; then
		printf 'OK, no oc2busd\n'
	else
		mkdir -p /run/oc2
		env LUA_PATH="$(lua_path)" daemon -r -S -T oc2busd \
		    -P "$PID_FILE" /usr/bin/lua "$DAEMON"
		# Wait until it listens: a program that finds no daemon opens
		# the ports itself, and on FreeBSD (unlike Linux) the daemon
		# can still open them too, and the two would read each other's
		# replies. Starting takes a few seconds on this CPU.
		i=0
		while [ ! -S /run/oc2/bus ] && [ "$i" -lt 600 ]; do
			sleep 0.1
			i=$((i + 1))
		done
		if [ -S /run/oc2/bus ]; then
			printf 'OK\n'
		else
			printf 'oc2busd is not listening yet\n'
		fi
	fi
}

stop() {
	if [ -f "$PID_FILE" ]; then
		printf 'Stopping oc2busd: '
		kill "$(cat "$PID_FILE")" 2>/dev/null
		rm -f "$PID_FILE"
		printf 'OK\n'
	fi
}

case "$1" in
	start|stop)
		"$1" ;;
	restart|reload)
		stop; sleep 1; start ;;
	*)
		echo "Usage: $0 {start|stop|restart|reload}"
		exit 1 ;;
esac
