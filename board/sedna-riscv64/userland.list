# The userland of the Sedna image: what scripts/build.sh copies from the
# installed world (make installworld distribution) into the root file system.
#
# One path per line, relative to /, shell globs allowed; a directory is copied
# with everything in it. Only list programs and data files: the shared
# libraries they need, and the libraries those need, are added automatically
# (from their ELF NEEDED entries), as is the run-time linker.
#
# Owners, modes and flags come from the installed world's METALOG.

# --- /bin
bin/[
bin/cat
bin/chmod
bin/cp
bin/date
bin/dd
bin/df
bin/echo
bin/expr
bin/hostname
bin/kenv
bin/kill
bin/link
bin/ln
bin/ls
bin/mkdir
bin/mv
bin/pgrep
bin/pkill
bin/ps
bin/pwd
bin/realpath
bin/rm
bin/rmdir
bin/sh
bin/sleep
bin/stty
bin/sync
bin/test
bin/unlink

# --- /sbin
sbin/devfs
sbin/dhclient
sbin/dhclient-script
sbin/dmesg
sbin/fastboot
sbin/fasthalt
sbin/fsck
sbin/fsck_4.2bsd
sbin/fsck_ffs
sbin/fsck_ufs
sbin/halt
sbin/ifconfig
sbin/init
sbin/ldconfig
sbin/mdconfig
sbin/mknod
sbin/mount
sbin/newfs
sbin/nologin
sbin/ping
sbin/poweroff
sbin/reboot
sbin/route
sbin/shutdown
sbin/swapctl
sbin/swapoff
sbin/swapon
sbin/sysctl
sbin/tunefs
sbin/umount

# --- /usr/bin
usr/bin/awk
usr/bin/basename
usr/bin/chgrp
usr/bin/clear
usr/bin/cmp
usr/bin/cut
usr/bin/diff
usr/bin/dirname
usr/bin/du
usr/bin/edit
usr/bin/ee
usr/bin/egrep
usr/bin/env
usr/bin/false
usr/bin/fgrep
usr/bin/find
usr/bin/grep
usr/bin/groups
usr/bin/gunzip
usr/bin/gzcat
usr/bin/gzip
usr/bin/head
usr/bin/hexdump
usr/bin/id
usr/bin/ldd
usr/bin/less
usr/bin/login
usr/bin/mktemp
usr/bin/more
usr/bin/nc
usr/bin/od
usr/bin/passwd
usr/bin/printf
usr/bin/readlink
usr/bin/reset
usr/bin/seq
usr/bin/sed
usr/bin/sort
usr/bin/stat
usr/bin/su
usr/bin/tail
usr/bin/tee
usr/bin/top
usr/bin/touch
usr/bin/tput
usr/bin/tr
usr/bin/true
usr/bin/tset
usr/bin/tty
usr/bin/uname
usr/bin/uniq
usr/bin/uptime
usr/bin/w
usr/bin/wc
usr/bin/which
usr/bin/whoami
usr/bin/xargs
usr/bin/yes
usr/bin/zcat

# --- /usr/sbin
usr/sbin/chown
usr/sbin/chroot
usr/sbin/pw
usr/sbin/pwd_mkdb
usr/sbin/syslogd

# --- /usr/libexec, /usr/lib
usr/libexec/getty
# Lua 5.4, see /usr/bin/lua in the overlay; with its modules (lfs, ucl, ...).
usr/libexec/flua
usr/lib/flua
# The PAM modules /etc/pam.d/{login,su,passwd,system,other} use.
usr/lib/pam_group.so*
usr/lib/pam_lastlog.so*
usr/lib/pam_login_access.so*
usr/lib/pam_nologin.so*
usr/lib/pam_permit.so*
usr/lib/pam_rootok.so*
usr/lib/pam_securetty.so*
usr/lib/pam_self.so*
usr/lib/pam_unix.so*
usr/lib/pam_xdg.so*

# --- /etc (the overlay adds and replaces more)
etc/dhclient.conf
etc/gettytab
etc/group
etc/hosts
etc/login.access
etc/login.conf
etc/login.conf.db
etc/master.passwd
etc/networks
etc/nsswitch.conf
etc/pam.d/login
etc/pam.d/other
etc/pam.d/passwd
etc/pam.d/su
etc/pam.d/system
etc/passwd
etc/protocols
etc/pwd.db
etc/services
etc/shells
etc/spwd.db
root/.shrc
