# Device			Mountpoint	FStype	Options		Dump	Pass#
/dev/ufs/power_bsd		/		ufs	rw		1	1
tmpfs				/tmp		tmpfs	rw,mode=1777	0	0
# Logs live in memory, as on the Sedna image.
tmpfs				/var/log	tmpfs	rw,size=1m,mode=755	0	0
# /run, as on Linux: OC2's bus daemon puts its socket and pid file there.
tmpfs				/run		tmpfs	rw,size=256k,mode=755	0	0
